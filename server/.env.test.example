# 통합 테스트 전용 DB. docker-compose 기동 시 movie_ticket_test가 자동 생성됩니다.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/movie_ticket_test?schema=public"
PORT=4001
NODE_ENV=test
CORS_ORIGIN="http://localhost:5173"
ACCESS_TOKEN_SECRET="test-access-secret"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="test-refresh-secret"
REFRESH_TOKEN_EXPIRES_IN="7d"
BCRYPT_ROUNDS=4